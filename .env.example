# Fireball Observatory Environment Configuration
# Copy this file to .env for local overrides.

# Optional: Remote API or CDN base URL for dataset artifacts (defaults to relative /data)
# VITE_DATA_BASE_URL=https://fireball-observatory.workers.dev/data

# Optional: Cloudflare R2 deployment settings
# CLOUDFLARE_R2_BUCKET=fireball-observatory-data
# CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
