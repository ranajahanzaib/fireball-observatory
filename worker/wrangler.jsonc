{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fireball-observatory",
  "main": "src/index.ts",
  "compatibility_date": "2024-11-12",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../apps/web/dist",
    "binding": "ASSETS",
  },
  "r2_buckets": [
    {
      "binding": "DATA_BUCKET",
      "bucket_name": "fireball-observatory-data",
    },
  ],
}
